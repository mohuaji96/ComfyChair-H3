    <!-- Tag composer: guard details -->
    <string name="tc_got_it">Got it</string>
    <string name="tc_guard_detail_title_four">What the four switches do</string>
    <string name="tc_guard_detail_title_three">What the three switches do</string>
    <string name="tc_guard_detail_intro_four">The top two are exclusive; the bottom two toggle on their own</string>
    <string name="tc_guard_detail_intro_three">The two below toggle on their own</string>
    <string name="tc_guard_block_strict_1">Words that fight each other are blocked: standing while lying, dressed while nude, the same idea twice</string>
    <string name="tc_guard_block_strict_2">Impossible frames are blocked too: only two hands, nowhere to sit, a back view with a chest description</string>
    <string name="tc_guard_block_strict_3">Style and main color each become a full sentence, which models read more reliably</string>
    <string name="tc_guard_block_normal_1">Only blocks words that fight each other, the first case above</string>
    <string name="tc_guard_block_normal_2">Hand count and space limits are not checked</string>
    <string name="tc_guard_block_normal_3">Style and main color output a few words, with no finishing phrase</string>
    <string name="tc_guard_block_dedupe_1">Within one slot, recently drawn words drop to a quarter chance, not disabled</string>
    <string name="tc_guard_block_dedupe_2">No effect with fewer than 4 candidates</string>
    <string name="tc_guard_block_nsfw_1">On draws adult words only, off draws everyday words only, never half and half in one output</string>
    <string name="tc_guard_block_nsfw_2">Kept after switching off: deep V, slits, backless, swimwear, lip bite. Sexy counts as everyday, only explicit is removed</string>
    <string name="tc_guard_block_nsfw_3">Does not apply to words you typed yourself or to the system prompt in Settings</string>
    <string name="tc_guard_note_pair">Tap the lit switch again and the other lights up; they never both go out.</string>
    <string name="tc_guard_note_strike">Struck-through words are unavailable in both modes, judged by the same rules.</string>
    <string name="tc_guard_tip_title">Note</string>
    <string name="tc_guard_tip_body">The cleanup built into Enhanced mode only joins style and main color into one sentence. Convenient, but still fallible. For better results, use Optimize in the bottom bar to rewrite via the API.</string>


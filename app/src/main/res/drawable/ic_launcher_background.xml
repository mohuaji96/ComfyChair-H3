<?xml version="1.0" encoding="utf-8"?>
<!-- Warm cream ground for the chair. A gradient rather than a flat colour: at launcher size the
     slight fall of light reads as a studio backdrop and keeps the mark from looking pasted on. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:startColor="#FFFAF4E9"
                android:endColor="#FFE9D6B8" />
        </aapt:attr>
    </path>
</vector>
